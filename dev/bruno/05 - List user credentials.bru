meta {
  name: 05 - List user credentials
  type: http
  seq: 5
}

get {
  url: {{base_url}}/admin/realms/{{realm}}/users/{{user_id}}/credentials
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
}

script:post-response {
  // Stocke l'id du premier credential de type "otp" dans `otp_credential_id`
  // pour la requête de delete suivante.
  if (res.status === 200 && Array.isArray(res.body)) {
    const otp = res.body.find(c => c.type === "otp");
    if (otp && otp.id) {
      bru.setEnvVar("otp_credential_id", otp.id);
    }
  }
}

docs {
  Endpoint Admin REST natif de Keycloak (pas exposé par cette extension).
  Le service account `totp-api-admin` a les rôles `realm-management/view-users`
  et `manage-users` dans le realm seedé, donc l'access_token de l'étape 01 suffit.
  La requête extrait l'id du credential OTP et le stocke dans `otp_credential_id`
  pour la requête `06 - Delete TOTP credential`.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("returns an array", function() {
    expect(res.body).to.be.an("array");
  });
}
