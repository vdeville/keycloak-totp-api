meta {
  name: 04 - Verify TOTP
  type: http
  seq: 4
}

post {
  url: {{base_url}}/realms/{{realm}}/totp-api/{{user_id}}/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "deviceName": "{{device_name}}",
    "code": "REPLACE_WITH_CURRENT_TOTP"
  }
}

docs {
  Récupère le code courant depuis la même source que `03 - Register TOTP` :
  app Authenticator, https://totp.danhersam.com/, ou `oathtool --totp -b "$ENCODED_SECRET"`.
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}
