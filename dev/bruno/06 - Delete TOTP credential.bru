meta {
  name: 06 - Delete TOTP credential
  type: http
  seq: 6
}

delete {
  url: {{base_url}}/admin/realms/{{realm}}/users/{{user_id}}/credentials/{{otp_credential_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
}

docs {
  Endpoint Admin REST natif de Keycloak (pas exposé par cette extension).
  Nécessite le rôle client `realm-management/manage-users`.
  La variable `otp_credential_id` est positionnée par `05 - List user credentials`
  (premier credential dont `type == "otp"`).
}

tests {
  test("status 204", function() {
    expect(res.status).to.equal(204);
  });
}
