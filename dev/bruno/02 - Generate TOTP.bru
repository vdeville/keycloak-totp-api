meta {
  name: 02 - Generate TOTP
  type: http
  seq: 2
}

get {
  url: {{base_url}}/realms/{{realm}}/totp-api/{{user_id}}/generate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.status === 200 && res.body && res.body.encodedSecret) {
    bru.setEnvVar("encoded_secret", res.body.encodedSecret);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("encodedSecret returned", function() {
    expect(res.body.encodedSecret).to.be.a("string");
  });
  test("qrCode returned", function() {
    expect(res.body.qrCode).to.be.a("string");
  });
}
